{
  "name": "proyecto-dlp",
  "version": "3.0.0",
  "description": "Laboratorio DLP de endpoint Windows: clasificación, controles de salida, auditoría y evaluación multicanal.",
  "main": "start.js",
  "scripts": {
    "start": "node start.js",
    "agent": "node endpoint/server.js",
    "web": "node app.js",
    "receiver": "node endpoint/receiver.js",
    "site:demo": "node endpoint/demo-site.js",
    "demo": "node start.js --demo",
    "test": "node scripts/test.js",
    "test:regression": "node --test test/content.test.js test/extension.test.js test/inspection.test.js test/semantic.test.js",
    "browser:install": "playwright install chromium",
    "setup": "node scripts/setup.js",
    "control": "node control/server.js",
    "lab": "node scripts/lab.js",
    "test:managed": "node evaluacion/managed-e2e.js",
    "groq:check": "node scripts/groq-check.js",
    "evaluate:hybrid": "node evaluacion/evaluar-hibrido.js",
    "doctor": "node scripts/doctor.js",
    "protection:prepare": "node scripts/protection-profile.js",
    "protection:plan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File endpoint/windows/Protection.ps1 -Action Plan",
    "protection:audit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File endpoint/windows/Protection.ps1 -Action Audit",
    "applications:plan": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File endpoint/windows/Native-Apps.ps1 -Action Plan",
    "applications:discover": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File endpoint/windows/Native-Apps.ps1 -Action Discover",
    "applications:audit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File endpoint/windows/Native-Apps.ps1 -Action Audit",
    "endpoint:export": "node scripts/export-endpoint.js",
    "vm:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/vm/Lab-VM.ps1 -Action Start",
    "vm:sync": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/vm/Lab-VM.ps1 -Action Sync",
    "vm:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/vm/Lab-VM.ps1 -Action Verify",
    "vm:ca": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/vm/Lab-VM.ps1 -Action ExportCA",
    "wsl:sync": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action Sync",
    "wsl:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action Start",
    "wsl:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action Status",
    "wsl:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action Stop",
    "wsl:verify": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action Verify",
    "wsl:ca": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File deploy/wsl/Lab-WSL.ps1 -Action ExportCA",
    "evaluate": "node evaluacion/evaluar.js",
    "evaluate:endpoint": "node scripts/evaluate-local.js endpoint",
    "extension:build": "node extension/build.js",
    "test:browser": "node scripts/evaluate-local.js browser",
    "test:windows": "node scripts/evaluate-local.js windows"
  },
  "keywords": [
    "dlp",
    "ciberseguridad",
    "express"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "argparse": "2.0.1",
    "uuid": "11.1.1"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "multer": "^2.5.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
