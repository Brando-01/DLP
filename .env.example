# PLANTILLA PUBLICA. Ejecuta npm.cmd run setup: crea .env privado y completa
# automaticamente tokens y passwords distintos para cada instalacion.
# Tambien funciona si antes copiaste esta plantilla a .env.
# TU UNICO DATO EXTERNO PENDIENTE: GROQ_API_KEY. Nunca publiques .env.

# 1. Clasificacion: completa solo esta clave en el .env privado, no aqui.
DLP_LLM_MODE=hybrid
# En hybrid, el inventario de carpetas vigiladas puede consultar al central
# al guardar cambios. En config.json: inventorySemantic=false desactiva ese
# procesamiento en reposo sin desactivar el de las salidas mediadas.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# 2. AUTOMATICOS: dejalos vacios en esta plantilla; setup los genera.
# ADMIN: acceso a consola :3100. INSPECT/TELEMETRY: uso interno, no navegador.
# El token de la EXTENSION es distinto y se obtiene en :3001 -> Navegador.
DLP_CONTROL_ADMIN_TOKEN=
DLP_INSPECT_TOKEN=
DLP_TELEMETRY_TOKEN=
DLP_LAB_PASSWORD=
DLP_WAZUH_ENROLLMENT_PASSWORD=

# 3. Una computadora Windows con servicios Docker/WSL locales.
# No cambies 3100 por 3001: 3100 es el control, 3001 es el agente/extensiones.
DLP_CONTROL_HOST=127.0.0.1
DLP_CONTROL_PORT=3100
DLP_CONTROL_URL=http://127.0.0.1:3100
# 0: control en WSL/Docker. npm run lab configura su propio control local.
DLP_CONTROL_EMBEDDED=0
DLP_INSPECTION_BACKEND=central
# Telemetria del agente hacia el control. No lleva texto de documentos.
DLP_FORWARD_EVENTS=1

# 4. Puertos Docker del laboratorio. WSL publica dentro de su entorno Linux.
# Estos valores no instalan certificados ni cambian el firewall de Windows.
DLP_LAB_BIND=127.0.0.1
DLP_SMB_HOST_PORT=1445
DLP_DNS_HOST_PORT=5300
