# Copia o genera .env con npm.cmd run setup. Nunca publiques .env.
DLP_LLM_MODE=hybrid
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Las claves del control central se generan por setup.
DLP_CONTROL_ADMIN_TOKEN=
DLP_INSPECT_TOKEN=
DLP_TELEMETRY_TOKEN=
DLP_CONTROL_HOST=127.0.0.1
DLP_CONTROL_PORT=3100
DLP_CONTROL_URL=http://127.0.0.1:3100
# 0 si el control ya corre en Docker o en la VM; 1 para npm start local.
DLP_CONTROL_EMBEDDED=0
DLP_INSPECTION_BACKEND=central
# Activar envío de telemetría del agente al control local.
DLP_FORWARD_EVENTS=1
DLP_LAB_PASSWORD=
DLP_WAZUH_ENROLLMENT_PASSWORD=
# Solo despliegue Docker en una red privada del laboratorio.
DLP_LAB_BIND=127.0.0.1
DLP_SMB_HOST_PORT=1445
DLP_DNS_HOST_PORT=5300
