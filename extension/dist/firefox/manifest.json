{
  "manifest_version": 3,
  "name": "DLP de laboratorio · Conector",
  "version": "2.0.0",
  "description": "Inspecciona interacciones manuales soportadas mediante el agente DLP local.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Configurar el conector DLP"
  },
  "background": {
    "scripts": [
      "connector.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dlp-laboratorio@brando.local",
      "strict_min_version": "128.0"
    }
  }
}