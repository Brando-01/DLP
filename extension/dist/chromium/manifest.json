{
  "manifest_version": 3,
  "name": "DLP de laboratorio · Conector",
  "version": "3.1.1",
  "description": "Inspecciona interacciones manuales soportadas mediante el agente DLP local.",
  "permissions": [
    "storage",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Configurar el conector DLP"
  },
  "background": {
    "service_worker": "background.js"
  },
  "minimum_chrome_version": "121"
}